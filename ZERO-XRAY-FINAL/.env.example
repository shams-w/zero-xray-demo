# =====================================================================
# AI ENGINE MODE -- pick ONE of the two blocks below (REAL or MOCK).
# =====================================================================
# ZX_LLM_MODE is a label only -- it controls the "analysis_source"
# value each agent records when its AI call succeeds ("ai" vs
# "MOCK_AI"), so it's always visible in logs/API responses which one
# actually ran. It does NOT change how requests are made; that's
# controlled purely by OLLAMA_HOST below. Switching modes requires
# ZERO changes to any agent code -- only these env vars move.

# ---------------------------------------------------------------
# REAL (default) -- talks to your real local Ollama installation.
# ---------------------------------------------------------------
# Install Ollama (https://ollama.com), then pull a model once, e.g.:
#   ollama pull qwen2.5:7b
#   ollama pull qwen3:4b
# Ollama must already be running on port 11434 before you start
# uvicorn, or every AI call falls back to the deterministic baseline
# automatically (safely) for every agent.
ZX_LLM_MODE=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Mandatory AI Mode: ZERO X-RAY's core Analyze pipeline REQUIRES a
# reachable Ollama + the configured model above by default. If Ollama
# is unreachable or the model isn't pulled, /api/analyze stops
# immediately with a structured "AI_ENGINE_UNAVAILABLE" error instead
# of silently completing on a deterministic fallback. This is the
# correct default for a real run -- only set REQUIRE_OLLAMA=false to
# intentionally go back to the old "always attempt, always fall back
# silently" behavior (e.g. a constrained sandbox with no Ollama at
# all). Predict/Simulate/Challenge/Evolve/Prevent/Monitoring are
# unaffected either way -- their scoring is deterministic Python and
# never gated on Ollama; only their optional AI-phrased explanation
# text uses it.
REQUIRE_OLLAMA=true

# ---------------------------------------------------------------
# CLOUD (recommended for Render) -- Groq + Qwen.
# Keep GROQ_API_KEY only in Render Environment; never commit it.
# This changes only the LLM transport. Existing agent prompts, JSON
# validation, analysis logic, and deterministic fallbacks stay intact.
# ---------------------------------------------------------------
# ZX_LLM_MODE=groq
# GROQ_API_KEY=<set-in-Render-only>
# GROQ_MODEL=qwen/qwen3.6-27b
# REQUIRE_OLLAMA=true

# ---------------------------------------------------------------
# MOCK -- talks to the standalone test-only mock server instead of
# real Ollama. Comment out the REAL block above and uncomment this
# block to use it. NEVER put the mock on port 11434 -- that's
# reserved for real Ollama. Start the mock first:
#   uvicorn tools.mock_ollama_server:app --host 127.0.0.1 --port 11435
# ---------------------------------------------------------------
# ZX_LLM_MODE=mock
# OLLAMA_HOST=http://127.0.0.1:11435
# OLLAMA_MODEL=qwen3:4b

# Optional (MOCK only): force a specific simulated AI failure on the
# mock server, to prove the deterministic fallback path works.
# One of: none | empty_response | invalid_json | chat_500 | timeout
# Can be set on the mock server's own process at startup, OR on the
# backend's process (the client) which forwards it as a per-request
# header -- both are honored; see tools/mock_ollama_server.py.
# ZX_MOCK_FAILURE_MODE=none

# =====================================================================
# ADVANCED (usually leave commented out)
# =====================================================================
# Default token budget / context window / timeout overrides.
# core/llm.py already sizes the context window per-call based on the
# actual prompt (with extra headroom for Arabic-heavy text), so you
# normally don't need to change these.
# OLLAMA_DEFAULT_MAX_NEW_TOKENS=400
# OLLAMA_NUM_CTX=8192
# Ceiling for the one-shot context-grow retry that fires when Ollama
# returns HTTP 200 with empty content because the prompt used up the
# whole context window (done_reason=length, eval_count=0). Must stay
# >= OLLAMA_NUM_CTX or the retry cannot help. Lower it to the same
# value as OLLAMA_NUM_CTX to disable growth entirely on a genuinely
# memory-constrained machine.
# OLLAMA_MAX_NUM_CTX=8192
# OLLAMA_DEFAULT_TIMEOUT_SECONDS=120

# =====================================================================
# DATABASE
# =====================================================================
# Local/demo default: leave DATABASE_URL unset to preserve the existing
# persistent SQLite behavior (ZX_DATA_ROOT / ZX_DATABASE_PATH below).
# You may also opt in explicitly with a SQLite URL:
# DATABASE_URL=sqlite:///D:/ZERO-XRAY-DATA/runtime.db
#
# Production PostgreSQL example (placeholder values only -- no credentials):
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
#
# DATABASE_URL takes precedence over ZX_DATA_ROOT / ZX_DATABASE_PATH when set.

# Persistent data root. On Windows the demo now defaults to D:/ZERO-XRAY-DATA
# when D: exists, otherwise ~/ZERO-XRAY-DATA. This keeps data across new ZIPs.
# ZX_DATA_ROOT=D:/ZERO-XRAY-DATA

# Optional direct database override (takes precedence over ZX_DATA_ROOT).
# ZX_DATABASE_PATH=D:/ZERO-XRAY-DATA/runtime.db

# Comma-separated browser origins allowed to call the API.
# ZX_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Frontend API base URL. Put this in client/.env when changing the port.
# VITE_API_URL=http://127.0.0.1:8000

# =====================================================================
# AUTHENTICATION
# =====================================================================
# Local development default. Keeps the existing ZERO X-RAY Demo login.
ZX_AUTH_PROVIDER=demo
ZX_DEMO_DEV_PASSPHRASE=<set-a-local-demo-passphrase>
# Employee/demo sessions expire server-side. Default shown: 8 hours.
ZX_EMPLOYEE_SESSION_TTL_SECONDS=28800

# Production OIDC / SSO (Microsoft Entra ID or compatible provider).
# Set ZX_AUTH_PROVIDER=external_oidc and configure ALL three values below.
# The external IdP handles passwords, SSO policy and MFA; ZERO X-RAY only
# accepts and server-validates the resulting signed OIDC token.
# ZX_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# ZX_OIDC_AUDIENCE=<application-client-id-or-api-audience>
# ZX_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# ZX_OIDC_EMAIL_CLAIM=preferred_username
# ZX_OIDC_ROLE_CLAIM=roles
# ZX_OIDC_ROLE_MAPPING_JSON={"ZXR.EntityAdmin":"entity_admin","ZXR.ServiceOwner":"service_owner","ZXR.Analyst":"analyst","ZXR.Viewer":"viewer"}
# ZX_OIDC_REQUIRE_MAPPED_ROLE=true

# UAE PASS is intentionally NOT emulated. Leave false until a real UAE PASS
# integration has been configured and verified. /api/auth/status reports
# NOT_CONNECTED while this is false.
ZX_UAE_PASS_CONNECTED=false

# Optional lightweight in-process Monitoring scheduler poll interval
ZX_MONITORING_SCHEDULER_POLL_SECONDS=60

# =====================================================================
# OPENAPI / SWAGGER IMPORT
# =====================================================================
# User-supplied OpenAPI/Swagger URLs are HTTPS-only and SSRF-checked by default.
# Keep both disabled for normal/public deployments.
ZX_OPENAPI_ALLOW_HTTP=false
ZX_OPENAPI_ALLOW_PRIVATE_HOSTS=false
# For a trusted corporate staging Swagger host that intentionally resolves to
# a private address, an operator may set ZX_OPENAPI_ALLOW_PRIVATE_HOSTS=true
# only in that controlled environment. Never use this as a public default.
